# Argus environment variables
#
# Copy to .env and fill in your real values.
# Never commit .env.

# =============================================================================
# Required
# =============================================================================

# Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdef_your_token_here

# Legacy single-destination publishing target.
# NOTE: This is used only when there are no per-stream Telegram subscriptions
# in the database (broadcast publishing will otherwise fan out to subscribers).
#
# A channel/supergroup ID typically looks like: -1001234567890
TELEGRAM_CHAT_ID=-1001234567890

# Postgres connection string
DATABASE_URL=postgresql://user:pass@localhost:5432/argus

# API key for LLM generation via OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# =============================================================================
# Telegram Control Plane (admin/approval)
# =============================================================================

# Owner Telegram user ID (only this user can approve access)
TELEGRAM_OWNER_USER_ID=123456789

# Admin group chat ID where approvals happen.
# NOTE: This does not automatically receive broadcasts unless the admin group chat is subscribed.
TELEGRAM_ADMIN_CHAT_ID=-1001234567890

# =============================================================================
# Optional
# =============================================================================

# Telegram formatting mode (default: MarkdownV2)
TELEGRAM_PARSE_MODE=MarkdownV2

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

